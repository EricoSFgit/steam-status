    end

    -- Pega o CFrame do alvo
    local targetCFrame = targetPart.CFrame
    
    -- Calcula a posição ideal:
    -- 1. Pega a posição do alvo
    -- 2. Soma o vetor "LookVector" (direção que o alvo olha) multiplicado pela distância
    -- Isso faz você ficar exatamente "atrás" ou "na frente" dependendo de como o alvo está orientado.
    -- Para ficar de FRENTE, usamos o LookVector. Se quiser do lado, use RightVector.
    
    local idealPosition = targetCFrame.Position + (targetCFrame.LookVector * stickDistance)
    
    -- CFrame ideal: Na posição ideal, olhando para o alvo
    local idealCFrame = CFrame.lookAt(idealPosition, targetCFrame.Position)
    
    -- Opcional: Se quiser que ele fique do LADO (esquerdo/direito) em vez de atrás/frente:
    -- local idealPosition = targetCFrame.Position + (targetCFrame.RightVector * stickDistance)
    
    -- APLICAÇÃO DIRETA (Teleporte suave/Instantâneo)
    -- Usar CFrame direto garante que você está colado.
    -- Se quiser suavizar, troque a linha abaixo por:
    -- humanoidRootPart.CFrame = humanoidRootPart.CFrame:Lerp(idealCFrame, 0.5)
    
    humanoidRootPart.CFrame = idealCFrame
end)

