-- ==========================================
-- FUNÇÕES AUXILIARES
-- ==========================================

local function updateUI()
    if currentTarget and currentTarget.Character then
        targetLabel.Text = "Alvo: " .. currentTarget.Name
        targetLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    else
        targetLabel.Text = "Alvo: Nenhum"
        targetLabel.TextColor3 = Color3.new(1, 1, 1)
    end

    if isStuck then
        statusLabel.Text = "Estado: GRUDADO"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    else
        statusLabel.Text = "Estado: Inativo"
        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    end
end

local function setMenuState(open)
    menuOpen = open
    local targetTransparency = open and 0.1 or 0.7
    local tweenInfo = TweenInfo.new(0.2)
    TweenService:Create(mainFrame, tweenInfo, {BackgroundTransparency = targetTransparency}):Play()
end

local function clearHighlight()
    if currentHighlight then
        currentHighlight:Destroy()
        currentHighlight = nil
    end
end

local function applyHighlightToPart(part)
    clearHighlight()
    if part then
        local highlight = Instance.new("Highlight")
        highlight.FillColor = highlightColor
        highlight.FillTransparency = 0.7
        highlight.OutlineColor = highlightColor
        highlight.OutlineTransparency = 0
        highlight.Parent = part
        currentHighlight = highlight
    end
end

local function refreshPlayerList()
    -- Limpa lista atual
    for _, child in pairs(scrollList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local order = 1
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Name = "PlayerBtn_" .. player.UserId
            btn.Text = "👤 " .. player.Name
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 14
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
            btn.BorderSizePixel = 0
            btn.Size = UDim2.new(1, 0, 0, 35)
            btn.LayoutOrder = order
            btn.Parent = scrollList
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
            
            -- Highlight visual se for o alvo atual
            if currentTarget == player then
                btn.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
                btn.TextColor3 = Color3.fromRGB(0, 255, 100)
            end

            btn.MouseButton1Click:Connect(function()
                currentTarget = player
                targetPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if not targetPart and player.Character then
                    targetPart = player.Character:WaitForChild("HumanoidRootPart", 5)
                end
                
                updateUI()
                if targetPart then
                    applyHighlightToPart(targetPart)
                end
                
                -- Atualiza a cor dos botões na lista
                for _, b in pairs(scrollList:GetChildren()) do
                    if b:IsA("TextButton") then
                        if b.Name == "PlayerBtn_" .. player.UserId then
                            b.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
                            b.TextColor3 = Color3.fromRGB(0, 255, 100)
                        else
                            b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
                            b.TextColor3 = Color3.new(1, 1, 1)
                        end
                    end
                end
            end)
            
            order += 1
        end
    end
end

